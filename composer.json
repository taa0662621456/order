{
  "name": "your-org/order-component",
  "description": "High-performance e-commerce Order Component for Symfony 7.x",
  "type": "library",
  "version": "0.4.0-beta",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "OrderComponent\\": "src/"
    }
  },
  "require": {
    "php": "8.4.*",
    "symfony/framework-bundle": "^7.0",
    "symfony/messenger": "^7.0",
    "symfony/doctrine-bridge": "^7.0",
    "api-platform/core": "^3.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^1.11",
    "vimeo/psalm": "7.0.0-beta6",
    "rector/rector": "^1.2"
  },
  "scripts": {
    "test": "vendor/bin/phpunit --colors=always",
    "analyse": "vendor/bin/phpstan analyse --level=max src",
    "refactor": "vendor/bin/rector process src --dry-run"
  }
}
