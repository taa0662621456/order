{
  "name": "order/component-iteration14-deploymon",
  "description": "Order Component Iteration 14: Deployment & Monitoring (prod Docker, compose, GH Actions CD, health/metrics, JWT)",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "symfony/framework-bundle": "^7.0",
    "symfony/dependency-injection": "^7.0",
    "symfony/config": "^7.0",
    "symfony/console": "^7.0",
    "symfony/routing": "^7.0",
    "symfony/http-foundation": "^7.0",
    "symfony/http-kernel": "^7.0",
    "symfony/messenger": "^7.0",
    "symfony/amqp-messenger": "^7.0",
    "symfony/rate-limiter": "^7.0",
    "symfony/monolog-bundle": "^3.8",
    "doctrine/orm": "^3.0",
    "doctrine/doctrine-bundle": "^2.12",
    "lexik/jwt-authentication-bundle": "^2.20"
  },
  "require-dev": {
    "symfony/test-pack": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "OrderComponent\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OrderComponent\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}