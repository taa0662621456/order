{
  "name": "order/component-iteration1-generator",
  "description": "Order Component Iteration 1 with Foundry generator CLI and integration tests",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "symfony/framework-bundle": "^7.0",
    "symfony/dependency-injection": "^7.0",
    "symfony/config": "^7.0",
    "symfony/console": "^7.0",
    "doctrine/orm": "^3.0",
    "doctrine/doctrine-bundle": "^2.12",
    "doctrine/migrations": "^3.8",
    "doctrine/doctrine-migrations-bundle": "^3.3",
    "ramsey/uuid": "^4.7"
  },
  "require-dev": {
    "symfony/test-pack": "^1.0",
    "doctrine/doctrine-fixtures-bundle": "^3.5",
    "zenstruck/foundry": "^1.37"
  },
  "autoload": {
    "psr-4": {
      "OrderComponent\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OrderComponent\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}