{
  "name": "order/component-iteration8-inventory-payment",
  "description": "Order Component Iteration 8: Inventory & Payment integration with real workflow transition 'pay' and OrderPayment entity",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "symfony/framework-bundle": "^7.0",
    "symfony/dependency-injection": "^7.0",
    "symfony/config": "^7.0",
    "symfony/console": "^7.0",
    "symfony/workflow": "^7.0",
    "doctrine/orm": "^3.0",
    "doctrine/doctrine-bundle": "^2.12"
  },
  "require-dev": {
    "symfony/test-pack": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "OrderComponent\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OrderComponent\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}