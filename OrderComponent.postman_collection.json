{
  "info": {
    "name": "OrderComponent API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currency\": \"USD\",\n  \"items\": [\n    {\n      \"sku\": \"SKU-1\",\n      \"quantity\": 2,\n      \"unitPrice\": 1000\n    },\n    {\n      \"sku\": \"SKU-2\",\n      \"quantity\": 1,\n      \"unitPrice\": 5000\n    }\n  ]\n}"
        }
      }
    },
    {
      "name": "Pay Order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/orders/{{id}}/pay",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders",
            "{{id}}",
            "pay"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"amount\": 7000}"
        }
      }
    },
    {
      "name": "Ship Order",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/orders/{{id}}/ship",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders",
            "{{id}}",
            "ship"
          ]
        }
      }
    },
    {
      "name": "Get Order",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/orders/{{id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders",
            "{{id}}"
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost"
    },
    {
      "key": "id",
      "value": "1"
    }
  ]
}